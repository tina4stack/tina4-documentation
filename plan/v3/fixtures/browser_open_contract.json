  "invariants": [
    {
      "id": "browser-open-development-only",
      "adr": "ADR-0070",
      "rule": "A launcher opens a browser only when the server it started is in development. Production never opens, and a falsy TINA4_NO_BROWSER does not change that.",
      "why": "A tab helps only a person who just started a development server; anywhere else it is noise or a tab onto production.",
      "suites": {
        "native": "src/main.rs"
      },
      "cases": [
        "browser_opens_in_development_with_nothing_set",
        "browser_never_opens_in_production"
      ]
    },
    {
      "id": "browser-open-no-browser-flag",
      "adr": "ADR-0070",
      "rule": "--no-browser vetoes the browser, even when TINA4_NO_BROWSER is falsy.",
      "why": "The flag is the operator's explicit answer for this run.",
      "suites": {
        "native": "src/main.rs"
      },
      "cases": [
        "browser_never_opens_with_the_no_browser_flag"
      ]
    },
    {
      "id": "browser-open-truthy-set",
      "adr": "ADR-0070",
      "rule": "TINA4_NO_BROWSER vetoes when it is true, 1, yes or on after trimming, in any case, whether it comes from the process environment or .env. Every other value, y and t included, does not veto.",
      "why": "One truthy set, the one every framework's is_truthy helper already uses; 'on' was silently ignored by the CLI, Python and PHP.",
      "suites": {
        "native": "src/main.rs"
      },
      "cases": [
        "browser_never_opens_when_no_browser_env_is_truthy",
        "browser_opens_when_no_browser_env_is_not_truthy",
        "dotenv_bool_accepts_on"
      ]
    },
    {
      "id": "browser-open-ci",
      "adr": "ADR-0070",
      "rule": "Under CI (CI set to a non-empty value outside false/0/no/off, trimmed, any case) no browser opens. An empty, blank or falsy CI does not veto.",
      "why": "CI=true is the convention, but Woodpecker sets CI=woodpecker; for a browser, not opening is the cheap mistake.",
      "suites": {
        "native": "src/main.rs"
      },
      "cases": [
        "browser_never_opens_under_ci",
        "browser_opens_when_ci_is_empty_or_falsy"
      ]
    },
    {
      "id": "serve-mode-resolution",
      "adr": "ADR-0070",
      "rule": "tina4 serve resolves its mode before spawning: --production wins, then --dev, then a tina4-js project is development, then a backend project is development only when TINA4_DEBUG is truthy (unset is production).",
      "why": "The CLI must agree with the framework it spawns about whether this is a development server.",
      "suites": {
        "native": "src/main.rs"
      },
      "cases": [
        "development_needs_a_truthy_debug_flag",
        "production_flag_beats_dev_flag_and_debug",
        "a_frontend_only_project_serves_in_development_without_debug"
      ]
    },
    {
      "id": "cli-opens-one-tab-and-silences-its-child",
      "adr": "ADR-0070",
      "rule": "tina4 serve opens at most one tab (the app URL, never /__dev), resolves variables from the process environment before .env, and always sets TINA4_NO_BROWSER=true for the framework server it spawns.",
      "why": "Two call sites opened the app and /__dev on every start. Verified end to end with PATH shims for open/xdg-open on fix/browser-open-gate, but no named test drives handle_serve yet.",
      "owed_by": [
        "native"
      ]
    },
    {
      "id": "framework-server-follows-the-gate",
      "adr": "ADR-0070",
      "rule": "Each framework's own server start (Python run(), PHP App::run() and bin/tina4php serve, Ruby Tina4.run!, Node startServer) applies all four vetoes with the ADR-0070 truthy and CI rules, and opens at most one tab.",
      "why": "Python and Node open in production and ignore CI, PHP App::run() never reads TINA4_NO_BROWSER, Ruby opens unconditionally.",
      "owed_by": [
        "python",
        "php",
        "ruby",
        "nodejs"
      ]
    },
    {
      "id": "framework-cli-honours-no-browser",
      "adr": "ADR-0070",
      "rule": "Every framework CLI that parses --no-browser passes it through to the server start.",
      "why": "tina4ruby start and tina4nodejs serve parse the flag and drop it.",
      "owed_by": [
        "ruby",
        "nodejs"
      ]
    },
    {
      "id": "cluster-worker-never-opens",
      "adr": "ADR-0070",
      "rule": "In a multi-process server only the primary may open the tab; a worker never does.",
      "why": "Node's TINA4_PRODUCTION cluster reaches the open call once per worker.",
      "owed_by": [
        "nodejs"
      ]
    }
  ]
}
