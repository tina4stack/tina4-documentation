RewriteEngine On

# Serve installer scripts as UTF-8 text. Without a text/* Content-Type, Windows
# PowerShell 5.1 hands back a System.Byte[] from `irm <url>` and from
# Invoke-WebRequest(...).Content, and Invoke-Expression then refuses it with
# "Cannot convert 'System.Byte[]' to the type 'System.String' required by
# parameter 'Command'". tina4.com sent no Content-Type for these, so both
# `irm https://tina4.com/install-skills.ps1 | iex` and the shim's own inner
# fetch broke. Forcing text/plain makes every PowerShell fetch return a String.
<FilesMatch "\.(ps1|sh)$">
    ForceType "text/plain; charset=utf-8"
</FilesMatch>

# Serve index.html for directory requests
DirectoryIndex index.html

# If the request is not a file or directory, try adding .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# PyConZA 2026 QR short links (printed on the A5 flyer and the business card).
# 302, not 301, on purpose: the QR codes are permanent ink, so the destination
# must stay changeable. QSD drops any query string a scanner app appends so the
# UTM parameters arrive clean. Fallback pages for non-Apache hosts live at
# docs/public/pycon/a5.html and docs/public/card.html.
RewriteRule ^pycon/a5/?$ https://tina4.com/get-started/?utm_source=pyconza&utm_medium=qr&utm_campaign=pyconza2026&utm_content=a5 [R=302,L,QSD]
RewriteRule ^card/?$ https://tina4.com/?utm_source=pyconza&utm_medium=qr&utm_campaign=pyconza2026&utm_content=card [R=302,L,QSD]
